# =============================================================================
# Voice Translator — Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of CORS origins (frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://vtranslate:vtranslate@localhost:5432/voice_translator
# When using Supabase directly:
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Use "supabase" or "dev" (dev = local JWT for development)
AUTH_PROVIDER=dev
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# LiveKit (use LiveKit Cloud during development)
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-cloud-project.livekit.cloud
LIVEKIT_API_KEY=api-xxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# How long LiveKit participant tokens are valid (seconds)
LIVEKIT_TOKEN_TTL=3600

# ---------------------------------------------------------------------------
# Realtime Translation AI
# ---------------------------------------------------------------------------
# Provider selection: "openai" or "gemini"
# - "openai": requires Tier 2+ account + $50 spend for Realtime API access
# - "gemini": free tier available, get key at https://aistudio.google.com/apikey
TRANSLATOR_PROVIDER=openai

# --- OpenAI Realtime API (used if TRANSLATOR_PROVIDER=openai) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# MUST be a bidirectional realtime model. Valid options (verify at
# https://platform.openai.com/docs/guides/realtime):
#   - gpt-4o-realtime-preview             (recommended — full quality)
#   - gpt-4o-realtime-preview-2024-12-17   (pinned version)
# Do NOT use "gpt-realtime-translate" (doesn't exist) or
# "gpt-4o-mini-realtime-preview" (text-in/audio-out only — no bidirectional audio).
REALTIME_TRANSLATION_MODEL=gpt-4o-realtime-preview
# Voice used for translated audio — must be a valid OpenAI realtime voice
# (alloy, echo, shimmer, nova, verse — verify in OpenAI docs).
REALTIME_TRANSLATION_VOICE=alloy
# OpenAI Realtime API base URL (override only if using a compatible gateway)
OPENAI_REALTIME_BASE_URL=wss://api.openai.com/v1/realtime

# --- Gemini Live API (used if TRANSLATOR_PROVIDER=gemini) ---
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini Live model — must support bidiGenerateContent.
# The translator will try each name in order until one works:
#   - gemini-2.5-flash-native-audio-latest       (most accounts have this)
#   - gemini-2.5-flash-preview-native-audio-dialog
#   - gemini-2.5-pro-preview-native-audio-dialog  (Pro variant)
#   - gemini-2.0-flash-live-001                   (older, may be retired)
#   - gemini-2.0-flash-exp                        (experimental)
# If all are rejected, run /api/v1/test/list-gemini-models to see what
# your key actually supports (look for supportedGenerationMethods includes
# bidiGenerateContent).
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
# Gemini voice options: Puck, Charon, Fenrir, Aoede, Leda, Orus
GEMINI_VOICE=Aoede

# ---------------------------------------------------------------------------
# Translation Agent tuning
# ---------------------------------------------------------------------------
VAD_PREFIX_PADDING_MS=250
VAD_SILENCE_DURATION_MS=350
# Initial playback jitter buffer (ms). Adaptive at runtime.
PLAYBACK_BUFFER_MS=100
# Max playback buffer before we aggressively drop (ms)
PLAYBACK_BUFFER_MAX_MS=400
# Sample rate used inside the agent pipeline (Hz)
AUDIO_SAMPLE_RATE=24000
# Number of channels
AUDIO_CHANNELS=1

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# Leave VITE_API_URL EMPTY in development — the Vite dev server proxies
# /api and /health to http://localhost:8000 (see apps/web/vite.config.ts).
# Only set this for production builds.
VITE_API_URL=
# Must match LIVEKIT_URL — the frontend connects directly to LiveKit Cloud.
VITE_LIVEKIT_URL=wss://your-livekit-cloud-project.livekit.cloud

# ---------------------------------------------------------------------------
# Stress test mode
# ---------------------------------------------------------------------------
STRESS_TEST_ENABLED=false
STRESS_TEST_CONCURRENCY=10
