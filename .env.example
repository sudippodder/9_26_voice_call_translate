# =============================================================================
# Voice Translator — Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of CORS origins (frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://vtranslate:vtranslate@localhost:5432/voice_translator
# When using Supabase directly:
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Use "supabase" or "dev" (dev = local JWT for development)
AUTH_PROVIDER=dev
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# LiveKit (use LiveKit Cloud during development)
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-cloud-project.livekit.cloud
LIVEKIT_API_KEY=api-xxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# How long LiveKit participant tokens are valid (seconds)
LIVEKIT_TOKEN_TTL=3600

# ---------------------------------------------------------------------------
# Realtime Translation AI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Realtime model name (configurable — change provider by swapping translator.py)
REALTIME_TRANSLATION_MODEL=gpt-realtime-translate
# Voice used for translated audio (provider-dependent)
REALTIME_TRANSLATION_VOICE=alloy
# OpenAI Realtime API base URL (override only if using a compatible gateway)
OPENAI_REALTIME_BASE_URL=wss://api.openai.com/v1/realtime

# ---------------------------------------------------------------------------
# Translation Agent tuning
# ---------------------------------------------------------------------------
VAD_PREFIX_PADDING_MS=250
VAD_SILENCE_DURATION_MS=350
# Initial playback jitter buffer (ms). Adaptive at runtime.
PLAYBACK_BUFFER_MS=100
# Max playback buffer before we aggressively drop (ms)
PLAYBACK_BUFFER_MAX_MS=400
# Sample rate used inside the agent pipeline (Hz)
AUDIO_SAMPLE_RATE=24000
# Number of channels
AUDIO_CHANNELS=1

# ---------------------------------------------------------------------------
# Frontend (Vite will read these via import.meta.env)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_LIVEKIT_URL=wss://your-livekit-cloud-project.livekit.cloud

# ---------------------------------------------------------------------------
# Stress test mode
# ---------------------------------------------------------------------------
STRESS_TEST_ENABLED=false
STRESS_TEST_CONCURRENCY=10
